{
  "entry": [
    "./app/**/*.{ts,vue}",
    "./server/**/*.{ts,vue}",
    "./test/**/*.{ts,vue}",
    "./shared/**/*.ts",
  ],
  "ignoreDependencies": [
    // For devtools
    "nuxtseo-devtools-host",
    // Frontend libraries
    "@vueuse/core",
    "vue-router",
    // Icons
    "@iconify-json/*",
    // Serve tools
    "serve",
    // Quality
    "oxfmt",
    "vue-tsc",
    // Node.js dependencies manager
    "taze",
  ],
}
